---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import announcementsData from '@/data/announcements.json';
import mutantsData from '@/data/mutants/mutants.json';
import raidsData from '@/data/guides/raids.json';
import specialLaddersData from '@/data/guides/special-ladders.json';
import materialData from '@/data/materials/material.json';
import dungeonCovers from '@/data/guides/dungeon-covers.json';
import { textureUrl } from '@/lib/texture-cdn';
import { translateItemId, getItemTexture } from '@/lib/craft-simulator';
import { getLocalisedName } from '@/lib/localisation';
import { getGeneIcon } from '@/lib/mutant-icons';
import { GENE_RU, bingoLabel } from '@/lib/mutant-dicts';
import bingosData from '@/data/bingos.json';
import {
  resolveDungeon,
  resolveMutantLite,
  type DungeonRaw,
  type MutantRaw,
  type MaterialEntry,
  type RewardResolveCtx,
  type ResolvedDungeon,
} from '@/lib/guides-resolve';
import BoxModal from '@/components/boxes/BoxModal.svelte';
import BingoMutantModal from '@/components/bingo/BingoMutantModal.svelte';
import boxesData from '@/data/boxes.json';
import { getMutantTexturePath } from '@/lib/bingo-textures';

interface AnnouncementItem {
  id: string;
  name: string;
  image?: string | null;
  addedNames?: string[];
}

const bingosById = new Map((bingosData as { id: string; title: string }[]).map((b) => [b.id, b.title]));
function formatBingoTitle(title: string, id: string): string {
  const labelById = bingoLabel(id);
  if (labelById && labelById !== id) return labelById;
  const labelByTitle = bingoLabel(title);
  if (labelByTitle && labelByTitle !== title) return labelByTitle;
  return title
    .replace(/^--------/, '')
    .replace(/_/g, ' ')
    .replace(/([a-z])([A-Z])/g, '$1 $2')
    .split(' ')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())
    .join(' ');
}

interface Announcement {
  id: string;
  date: string;
  category?: string;
  title?: string;
  text?: string | null;
  imagePath?: string | null;
  sourceUrl?: string | null;
  items?: AnnouncementItem[] | null;
  link?: string | null;
}

const CATEGORY_RU: Record<string, string> = {
  mutant: 'Мутанты',
  skin: 'Скины',
  bingo: 'Бинго',
  box: 'Боксы',
  exchange: 'Обменники',
  raid: 'Рейды',
  ladder: 'Лесенки',
  reactor: 'Реакторы',
  token: 'Жетоны',
  shopForecast: 'Прогноз магазина',
  dailyNews: 'Скоро в игре',
  rebalance: 'Ребаланс',
};

// Тот же резолвер наград/данжей, что и /guides (src/lib/guides-resolve.ts) -
// рейды/лесенки на анонсах показывают ТЕ ЖЕ иконки/названия/фон, без второй
// независимой реализации, которая рано или поздно разъедется.
const mutantsById = new Map((mutantsData as MutantRaw[]).map((m) => [m.id, m]));
const materialsById = new Map((materialData as MaterialEntry[]).map((m) => [m.id, m]));
const rewardCtx: RewardResolveCtx = {
  mutantsById,
  materialsById,
  translateItemId,
  getItemTexture,
  getLocalisedName,
  getGeneIcon,
  geneRu: GENE_RU,
};
const dungeonById = new Map<string, ResolvedDungeon>(
  [
    ...(raidsData as DungeonRaw[]),
    ...(specialLaddersData as { experiment: DungeonRaw[]; challenge: DungeonRaw[] }).experiment,
    ...(specialLaddersData as { experiment: DungeonRaw[]; challenge: DungeonRaw[] }).challenge,
  ].map((d) => [d.id, resolveDungeon(d, rewardCtx)]),
);
const dungeonCoversMap = dungeonCovers as Record<string, string | null>;

interface BoxMutantRef { id: string; name: string; tier: string | null; skin: string | null }
interface BoxGroup { chance: number | null; mutants: BoxMutantRef[]; rewards: { name: string; type: string; amount: number }[] }
interface BoxEntry {
  itemId: string; icon: string | null; category: string; name: string;
  price: { amount: number; type: 'hardcurrency' | 'softcurrency' } | null;
  groups: BoxGroup[];
}
const boxesById = new Map((boxesData as BoxEntry[]).map((b) => [b.itemId, b]));
const TIER_ICON: Record<string, string> = {
  'бронза': '/stars/star_bronze.webp',
  'серебро': '/stars/star_silver.webp',
  'золото': '/stars/star_gold.webp',
  'платина': '/stars/star_platinum.webp',
};
function formatPrice(price: BoxEntry['price']): string | null {
  if (!price) return null;
  const label = price.type === 'hardcurrency' ? 'золота' : 'серебра';
  return `${price.amount.toLocaleString('ru-RU')} ${label}`;
}
function boxMutantIcon(m: BoxMutantRef): string {
  const variant = (m.tier && ['бронза', 'серебро', 'золото', 'платина'].includes(m.tier)
    ? { 'бронза': 'bronze', 'серебро': 'silver', 'золото': 'gold', 'платина': 'platinum' }[m.tier]
    : 'normal') as 'normal' | 'bronze' | 'silver' | 'gold' | 'platinum';
  return getMutantTexturePath(m.id, m.skin ?? '_any', variant);
}
function uniqueBoxMutants(box: BoxEntry): BoxMutantRef[] {
  const seen = new Set<string>();
  const out: BoxMutantRef[] = [];
  for (const g of box.groups) {
    for (const m of g.mutants) {
      if (seen.has(m.id)) continue;
      seen.add(m.id);
      out.push(m);
    }
  }
  return out;
}
function boxDescription(box: BoxEntry): string {
  const pool = box.groups.filter((g) => g.chance != null);
  if (pool.length === 0) return 'Гарантированное содержимое';
  const chances = new Set(pool.map((g) => g.chance!.toFixed(1)));
  if (chances.size === 1) {
    return `Случайный выбор · ${pool.length} равновероятных слотов, шанс ${pool[0].chance!.toFixed(1)}%`.toUpperCase();
  }
  return `Случайный выбор · ${pool.length} слотов с разным шансом`.toUpperCase();
}

type CardKind = 'dungeon' | 'mutant' | 'skin' | 'reactor' | 'box' | 'bingo' | 'generic';

function cardKind(category: string | undefined): CardKind {
  if (category === 'raid' || category === 'ladder') return 'dungeon';
  if (category === 'mutant') return 'mutant';
  if (category === 'skin') return 'skin';
  if (category === 'reactor') return 'reactor';
  if (category === 'box') return 'box';
  if (category === 'bingo') return 'bingo';
  return 'generic';
}

const announcements = ((announcementsData as Announcement[]) ?? [])
  .slice()
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .map((a) => ({ ...a, kind: cardKind(a.category) }));

// Порядок вкладок - по частоте/важности, не по алфавиту; "Все" всегда первая.
const CATEGORY_ORDER = [
  'dailyNews',
  'shopForecast',
  'mutant',
  'skin',
  'exchange',
  'box',
  'reactor',
  'raid',
  'ladder',
  'token',
  'bingo',
  'rebalance',
];
const presentCategories = [...new Set(announcements.map((a) => a.category).filter((c): c is string => !!c))].sort(
  (a, b) => CATEGORY_ORDER.indexOf(a) - CATEGORY_ORDER.indexOf(b),
);

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title="Анонсы — Archivist-Library">
  <main class="announcements-page">
    <h1>Анонсы</h1>
    <p class="intro">Новости и анонсы по игре Mutants Genetic Gladiators.</p>

    {announcements.length === 0 ? (
      <div class="empty">Анонсов пока нет — заглядывай позже.</div>
    ) : (
      <>
        {presentCategories.length > 1 && (
          <div class="filter-bar" role="tablist">
            <button type="button" class="filter-pill is-active" data-filter="all">Все</button>
            {presentCategories.map((c) => (
              <button type="button" class="filter-pill" data-filter={c}>{CATEGORY_RU[c] ?? c}</button>
            ))}
          </div>
        )}
        <div class="feed">
        {announcements.map((a) => {
          const it = a.items?.[0];
          const dungeon = a.kind === 'dungeon' && it ? dungeonById.get(it.id) : null;
          const dungeonCover = a.kind === 'dungeon' && it ? dungeonCoversMap[it.id] : null;
          const mutantLite = a.kind === 'mutant' && it ? resolveMutantLite(it.id, mutantsById) : null;
          const skinBaseId = a.kind === 'skin' && it ? it.id.split('|')[0]?.toLowerCase() : null;
          return (
          <article class="card" data-category={a.category ?? ''} data-announcement-id={a.id}>
            {a.kind === 'dungeon' && dungeon ? (
              <div class="dg-card">
                <div
                  class="dg-hero"
                  style={dungeonCover ? `background-image: linear-gradient(180deg, rgba(10,14,22,0.15), rgba(10,14,22,0.8)), url(${dungeonCover})` : undefined}
                >
                  {dungeon.mutant && (
                    <button class="dg-hero-btn" data-open-mutant={dungeon.mutant.id} title={`Открыть ${dungeon.mutant.name}`}>
                      <img class="dg-hero-art" src={textureUrl(dungeon.mutant.fullArt)} alt={dungeon.mutant.name} loading="lazy" decoding="async" />
                    </button>
                  )}
                </div>
                <div class="dg-body">
                  <time class="card-date" datetime={a.date}>{fmtDate(a.date)}</time>
                  <span class="card-category">{CATEGORY_RU[a.category ?? ''] ?? a.category}</span>
                  <div class="dg-name">{dungeon.name}</div>
                  {dungeon.mutant ? (
                    <button class="dg-mutant-name" data-open-mutant={dungeon.mutant.id}>{dungeon.mutant.name}</button>
                  ) : (
                    <div class="dg-mutant-name muted">без уникального мутанта</div>
                  )}
                  <div class="dg-secondary">{dungeon.fightCount} боёв</div>
                  {dungeon.currency.length > 0 && (
                    <div class="dg-currency">
                      {dungeon.currency.map((c) => (
                        <span class="reward-inline">
                          {c.icon && <img src={textureUrl(c.icon)} alt="" loading="lazy" decoding="async" />}
                          {c.label}
                        </span>
                      ))}
                    </div>
                  )}
                  {dungeon.items.length > 0 && (
                    <div class="dg-items">
                      {dungeon.items.map((it2) => (
                        <span class="dg-item-chip" title={it2.label}>
                          {it2.icon && <img src={textureUrl(it2.icon)} alt="" loading="lazy" decoding="async" />}
                          <span>{it2.label}</span>
                        </span>
                      ))}
                    </div>
                  )}
                  <a class="card-source" href={a.link ?? '/guides'}>Подробнее →</a>
                </div>
              </div>
            ) : a.kind === 'mutant' && mutantLite ? (
              <div class="hero-card">
                <button class="hero-art-btn" data-open-mutant={mutantLite.id} title={`Открыть ${mutantLite.name}`}>
                  <img class="hero-art" src={textureUrl(mutantLite.fullArt)} alt={mutantLite.name} loading="lazy" decoding="async" />
                </button>
                <div class="card-body">
                  <time class="card-date" datetime={a.date}>{fmtDate(a.date)}</time>
                  <span class="card-category">{CATEGORY_RU.mutant}</span>
                  <button class="hero-name-btn" data-open-mutant={mutantLite.id}>{mutantLite.name}</button>
                  <a class="card-source" href={a.link ?? '/mutants'}>Подробнее →</a>
                </div>
              </div>
            ) : a.kind === 'skin' && it && skinBaseId ? (
              <div class="hero-card">
                <button class="hero-art-btn" data-open-mutant={skinBaseId} title={`Открыть ${it.name}`}>
                  {it.image && <img class="hero-art" src={textureUrl(it.image)} alt={it.name} loading="lazy" decoding="async" />}
                </button>
                <div class="card-body">
                  <time class="card-date" datetime={a.date}>{fmtDate(a.date)}</time>
                  <span class="card-category">{CATEGORY_RU.skin}</span>
                  <button class="hero-name-btn" data-open-mutant={skinBaseId}>{it.name}</button>
                  <a class="card-source" href={a.link ?? '/mutants'}>Подробнее →</a>
                </div>
              </div>
            ) : a.kind === 'reactor' && it ? (
              <div class="hero-card">
                <a class="hero-art-btn" href={`/simulators/reactor/${it.id}`} title={`Открыть реактор «${it.name}»`}>
                  {it.image && <img class="hero-art" src={textureUrl(it.image)} alt={it.name} loading="lazy" decoding="async" />}
                </a>
                <div class="card-body">
                  <time class="card-date" datetime={a.date}>{fmtDate(a.date)}</time>
                  <span class="card-category">{CATEGORY_RU.reactor}</span>
                  <a class="hero-name-btn" href={`/simulators/reactor/${it.id}`}>{it.name}</a>
                  <a class="card-source" href={`/simulators/reactor/${it.id}`}>Открыть реактор →</a>
                </div>
              </div>
            ) : a.kind === 'box' && it && boxesById.get(it.id) ? (
              (() => { const box = boxesById.get(it.id)!; const boxMutants = uniqueBoxMutants(box).slice(0, 8); return (
              <button class="box-preview-card" data-open-box={box.itemId} title={`Открыть ${box.name}`}>
                <div class="box-preview-head">
                  <time class="card-date" datetime={a.date}>{fmtDate(a.date)}</time>
                  <div class="box-preview-tags">
                    <span class="card-category">{CATEGORY_RU.box}</span>
                    {box.category && <span class="box-preview-subcat">{box.category}</span>}
                  </div>
                </div>
                <div class="box-preview-main">
                  {box.icon && <img class="box-preview-icon" src={textureUrl(box.icon)} alt="" loading="lazy" decoding="async" />}
                  <div class="box-preview-title">
                    <div class="box-preview-name">{box.name}</div>
                    {formatPrice(box.price) && <div class="box-preview-price">{formatPrice(box.price)}</div>}
                  </div>
                </div>
                <div class="box-preview-desc">{boxDescription(box)}</div>
                {boxMutants.length > 0 && (
                  <div class="box-preview-grid">
                    {boxMutants.map((m) => (
                      <div class="box-preview-mutant">
                        <span class="box-preview-mutant-img">
                          <img src={textureUrl(boxMutantIcon(m))} alt="" loading="lazy" decoding="async" />
                        </span>
                        <span class="box-preview-mutant-name">{m.name}</span>
                        {m.tier && TIER_ICON[m.tier] && (
                          <img class="box-preview-tier" src={textureUrl(TIER_ICON[m.tier])} alt={m.tier} loading="lazy" decoding="async" />
                        )}
                      </div>
                    ))}
                  </div>
                )}
              </button>
              ); })()
            ) : a.kind === 'bingo' && it ? (
              <div class="hero-card">
                <div class="dg-hero bingo-hero">
                  <img class="bingo-screenshot" src={`/api/screenshot-bingo?board=${encodeURIComponent(it.id)}`} alt={formatBingoTitle(bingosById.get(it.id) ?? it.name, it.id)} loading="lazy" decoding="async" />
                </div>
                <div class="card-body">
                  <time class="card-date" datetime={a.date}>{fmtDate(a.date)}</time>
                  <span class="card-category">{CATEGORY_RU.bingo}</span>
                  <div class="dg-name">{formatBingoTitle(bingosById.get(it.id) ?? it.name, it.id)}</div>
                  {it.addedNames && it.addedNames.length > 0 ? (
                    <div class="dg-secondary">Добавлен{it.addedNames.length > 1 ? 'ы' : ''}: {it.addedNames.join(', ')}</div>
                  ) : (
                    <div class="dg-secondary">Новое бинго</div>
                  )}
                  <a class="card-source" href={a.link ?? '/bingo'}>Подробнее →</a>
                </div>
              </div>
            ) : (
              <>
                {a.imagePath && (
                  <div class="card-image">
                    <img src={a.imagePath} alt="" loading="lazy" decoding="async" />
                  </div>
                )}
                <div class="card-body">
                  <time class="card-date" datetime={a.date}>{fmtDate(a.date)}</time>
                  {a.category && <span class="card-category">{CATEGORY_RU[a.category] ?? a.category}</span>}
                  {a.title && <h2 class="card-title">{a.title}</h2>}
                  {a.text && <p class="card-text">{a.text}</p>}
                  {a.items && a.items.length > 0 && (
                    <ul class:list={['item-grid', { 'item-grid-token': a.category === 'token' }]}>
                      {a.items.map((it2) => (
                        <li class="item-card">
                          {it2.image && (
                            <img class="item-image" src={textureUrl(it2.image)} alt={it2.name} loading="lazy" decoding="async" />
                          )}
                          <span class="item-name">{it2.name}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  {a.link && (
                    <a class="card-source" href={a.link}>Подробнее →</a>
                  )}
                  {a.sourceUrl && (
                    <a class="card-source" href={a.sourceUrl} target="_blank" rel="noopener noreferrer">Источник →</a>
                  )}
                </div>
              </>
            )}
          </article>
          );
        })}
        </div>
      </>
    )}
  </main>

  <BoxModal client:load />
  <BingoMutantModal client:load />
</BaseLayout>

<script>
  const bar = document.querySelector<HTMLDivElement>('.filter-bar');
  if (bar) {
    const pills = Array.from(bar.querySelectorAll<HTMLButtonElement>('.filter-pill'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.card'));
    bar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.filter-pill');
      if (!btn) return;
      const filter = btn.dataset.filter ?? 'all';
      pills.forEach((p) => p.classList.toggle('is-active', p === btn));
      cards.forEach((card) => {
        card.style.display = filter === 'all' || card.dataset.category === filter ? '' : 'none';
      });
    });
  }

  document.querySelectorAll<HTMLElement>('[data-open-mutant]').forEach((el) => {
    el.addEventListener('click', () => {
      window.dispatchEvent(
        new CustomEvent('archivist:open-mutant', { detail: { specimenId: el.dataset.openMutant } }),
      );
    });
  });

  document.querySelectorAll<HTMLElement>('[data-open-box]').forEach((el) => {
    el.addEventListener('click', () => {
      window.dispatchEvent(
        new CustomEvent('archivist:open-box', { detail: { boxId: el.dataset.openBox } }),
      );
    });
  });
</script>

<style>
  .announcements-page {
    max-width: 760px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }
  h1 {
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
  }
  .intro {
    color: #94a3b8;
    margin-bottom: 1.5rem;
  }
  .empty {
    padding: 2rem;
    text-align: center;
    color: #94a3b8;
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
  }
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .filter-pill {
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    color: #94a3b8;
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    cursor: pointer;
    transition: color 0.15s, background 0.15s, border-color 0.15s;
  }
  .filter-pill:hover {
    color: #e2e8f0;
  }
  .filter-pill.is-active {
    color: rgb(96, 165, 250);
    background: rgba(96, 165, 250, 0.12);
    border-color: rgba(96, 165, 250, 0.35);
  }
  .feed {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .card {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    overflow: hidden;
  }
  .card-image {
    width: 100%;
    max-height: 420px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.3);
  }
  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .card-body {
    padding: 1rem 1.1rem 1.2rem;
  }
  .card-date {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: rgb(96, 165, 250);
    background: rgba(96, 165, 250, 0.12);
    border: 1px solid rgba(96, 165, 250, 0.35);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    margin-bottom: 0.6rem;
  }
  .card-category {
    display: inline-block;
    margin-left: 0.5rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: rgb(250, 204, 21);
    background: rgba(250, 204, 21, 0.12);
    border: 1px solid rgba(250, 204, 21, 0.35);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
  }
  .card-title {
    margin: 0.6rem 0 0.3rem;
    font-size: 1.15rem;
    color: #fceabb;
  }
  .card-text {
    color: #e2e8f0;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .item-grid {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0.7rem 0;
    padding: 0;
  }
  .item-card {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 0.4rem 0.7rem 0.4rem 0.4rem;
  }
  .item-image {
    width: 36px;
    height: 36px;
    object-fit: contain;
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.3);
  }
  .item-grid-token .item-image {
    width: 56px;
    height: 56px;
  }
  .item-grid-token .item-card {
    padding: 0.5rem 0.9rem 0.5rem 0.5rem;
  }
  .item-name {
    font-size: 0.85rem;
    color: #e2e8f0;
  }
  .card-source {
    display: inline-block;
    margin-top: 0.7rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: rgb(96, 165, 250);
    text-decoration: none;
  }
  .card-source:hover {
