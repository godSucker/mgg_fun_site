---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import announcementsData from '@/data/announcements.json';
import { textureUrl } from '@/lib/texture-cdn';

interface AnnouncementItem {
  id: string;
  name: string;
  image?: string | null;
}

interface Announcement {
  id: string;
  date: string;
  category?: string;
  title?: string;
  text?: string | null;
  imagePath?: string | null;
  sourceUrl?: string | null;
  items?: AnnouncementItem[] | null;
  link?: string | null;
}

const CATEGORY_RU: Record<string, string> = {
  mutant: 'Мутанты',
  skin: 'Скины',
  bingo: 'Бинго',
  box: 'Боксы',
  exchange: 'Обменники',
  raid: 'Рейды',
  ladder: 'Лесенки',
  reactor: 'Реакторы',
  rebalance: 'Ребаланс',
};

const announcements = ((announcementsData as Announcement[]) ?? [])
  .slice()
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

// Порядок вкладок - по частоте/важности, не по алфавиту; "Все" всегда первая.
const CATEGORY_ORDER = ['mutant', 'skin', 'exchange', 'box', 'reactor', 'raid', 'ladder', 'bingo', 'rebalance'];
const presentCategories = [...new Set(announcements.map((a) => a.category).filter((c): c is string => !!c))].sort(
  (a, b) => CATEGORY_ORDER.indexOf(a) - CATEGORY_ORDER.indexOf(b),
);

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title="Анонсы — Archivist-Library">
  <main class="announcements-page">
    <h1>Анонсы</h1>
    <p class="intro">Новости и анонсы по игре Mutants Genetic Gladiators.</p>

    {announcements.length === 0 ? (
      <div class="empty">Анонсов пока нет — заглядывай позже.</div>
    ) : (
      <>
        {presentCategories.length > 1 && (
          <div class="filter-bar" role="tablist">
            <button type="button" class="filter-pill is-active" data-filter="all">Все</button>
            {presentCategories.map((c) => (
              <button type="button" class="filter-pill" data-filter={c}>{CATEGORY_RU[c] ?? c}</button>
            ))}
          </div>
        )}
        <div class="feed">
        {announcements.map((a) => (
          <article class="card" data-category={a.category ?? ''}>

            {a.imagePath && (
              <div class="card-image">
                <img src={a.imagePath} alt="" loading="lazy" decoding="async" />
              </div>
            )}
            <div class="card-body">
              <time class="card-date" datetime={a.date}>{fmtDate(a.date)}</time>
              {a.category && <span class="card-category">{CATEGORY_RU[a.category] ?? a.category}</span>}
              {a.title && <h2 class="card-title">{a.title}</h2>}
              {a.text && <p class="card-text">{a.text}</p>}
              {a.items && a.items.length > 0 && (
                <ul class="item-grid">
                  {a.items.map((it) => (
                    <li class="item-card">
                      {it.image && (
                        <img class="item-image" src={textureUrl(it.image)} alt={it.name} loading="lazy" decoding="async" />
                      )}
                      <span class="item-name">{it.name}</span>
                    </li>
                  ))}
                </ul>
              )}
              {a.link && (
                <a class="card-source" href={a.link}>
                  Подробнее →
                </a>
              )}
              {a.sourceUrl && (
                <a class="card-source" href={a.sourceUrl} target="_blank" rel="noopener noreferrer">
                  Источник →
                </a>
              )}
            </div>
          </article>
        ))}
        </div>
      </>
    )}
  </main>
</BaseLayout>

<script>
  const bar = document.querySelector<HTMLDivElement>('.filter-bar');
  if (bar) {
    const pills = Array.from(bar.querySelectorAll<HTMLButtonElement>('.filter-pill'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.card'));
    bar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.filter-pill');
      if (!btn) return;
      const filter = btn.dataset.filter ?? 'all';
      pills.forEach((p) => p.classList.toggle('is-active', p === btn));
      cards.forEach((card) => {
        card.style.display = filter === 'all' || card.dataset.category === filter ? '' : 'none';
      });
    });
  }
</script>

<style>
  .announcements-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }
  h1 {
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
  }
  .intro {
    color: #94a3b8;
    margin-bottom: 1.5rem;
  }
  .empty {
    padding: 2rem;
    text-align: center;
    color: #94a3b8;
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
  }
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .filter-pill {
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    color: #94a3b8;
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    cursor: pointer;
    transition: color 0.15s, background 0.15s, border-color 0.15s;
  }
  .filter-pill:hover {
    color: #e2e8f0;
  }
  .filter-pill.is-active {
    color: rgb(96, 165, 250);
    background: rgba(96, 165, 250, 0.12);
    border-color: rgba(96, 165, 250, 0.35);
  }
  .feed {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .card {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    overflow: hidden;
  }
  .card-image {
    width: 100%;
    max-height: 420px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.3);
  }
  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .card-body {
    padding: 1rem 1.1rem 1.2rem;
  }
  .card-date {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: rgb(96, 165, 250);
    background: rgba(96, 165, 250, 0.12);
    border: 1px solid rgba(96, 165, 250, 0.35);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    margin-bottom: 0.6rem;
  }
  .card-category {
    display: inline-block;
    margin-left: 0.5rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: rgb(250, 204, 21);
    background: rgba(250, 204, 21, 0.12);
    border: 1px solid rgba(250, 204, 21, 0.35);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
  }
  .card-title {
    margin: 0.6rem 0 0.3rem;
    font-size: 1.15rem;
    color: #fceabb;
  }
  .card-text {
    color: #e2e8f0;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .item-grid {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0.7rem 0;
    padding: 0;
  }
  .item-card {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 0.4rem 0.7rem 0.4rem 0.4rem;
  }
  .item-image {
    width: 36px;
    height: 36px;
    object-fit: contain;
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.3);
  }
  .item-name {
    font-size: 0.85rem;
    color: #e2e8f0;
  }
  .card-source {
    display: inline-block;
    margin-top: 0.7rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: rgb(96, 165, 250);
    text-decoration: none;
  }
  .card-source:hover {
    text-decoration: underline;
  }
</style>
