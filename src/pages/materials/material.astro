---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import MaterialsTable from '../../components/materials/MaterialsTable.astro';
import materials from '../../data/materials/material.json';
import sourcesMap from '../../data/materials/sources.json';

// Запрет масштабирования на мобильных для страницы материалов
const NO_ZOOM_VIEWPORT = "width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no";

// -----------------------------------------------------------------------------
// Хронологическая сортировка жетонов (задача 7.13, 2026-08-08).
//
// В material.json жетоны лежат в порядке добавления - руками сверху и
// автопарсером (detect-tokens.ts) в конец. Пользователю удобнее видеть их
// в хронологии ивентов - от старых Пасх/Годовщин к новым.
//
// Дата события живёт не в самом material.json, а в sources.json - в тексте
// поля `where` типа "Пасхальный ивент 2021". Извлекаем год регуляркой,
// внутри года ставим сезон по календарю (Валентинов день -> Пасха ->
// Годовщина -> Хэллоуин -> Мистический ивент -> Рождество).
//
// "Вечные" жетоны без даты (Daily/Jackpot/Gacha/Event/Love) идут в НАЧАЛО
// списка - они старше эры сезонных ивентов.
//
// Всё остальное (материалы, здания, сферы и т.д.) остаётся на своём месте:
// сортировка применяется ТОЛЬКО к id, начинающимся на Material_*Token/
// Material_Preorder_Token, а также к особым историческим жетонам
// (Daily_Token, Material_Halloween_Soul, Material_Easter_2019_*).
// -----------------------------------------------------------------------------

// ID выглядит как жетон/материал ивента?
function isTokenId(id: string): boolean {
  if (/token/i.test(id)) return true;
  if (id === 'Material_Halloween_Soul') return true;
  if (/^Material_Easter_\d{4}_Choco/i.test(id)) return true;
  return false;
}

// "Вечные" жетоны без привязки к году - идут в начало.
const EVERGREEN_TOKENS = new Set([
  'Daily_Token',
  'Material_Jackpot_Token',
  'Material_Gacha_Token',
  'Material_Event_Token',
  'Material_Love_Token',
]);

// Порядок сезонов внутри одного года (месяц ивента в MGG).
// Чем меньше число - тем раньше в году.
function seasonOrder(where: string): number {
  const w = where.toLowerCase();
  if (w.includes('валентин')) return 2;   // февраль
  if (w.includes('пасх') || w.includes('easter')) return 4; // март-апрель
  if (w.includes('годовщин')) return 5;   // май
  if (w.includes('хэллоуин') || w.includes('halloween')) return 10; // октябрь
  if (w.includes('мистич') || w.includes('таинствен') || w.includes('weirdtech')) return 11; // ноябрь
  if (w.includes('рождеств') || w.includes('новог')) return 12; // декабрь
  return 6; // неизвестный сезон - середина года, стабильный fallback
}

// Хардкод-мапа для preorder-жетонов (нет года в тексте where).
// Опирается на код мутанта - когда он был добавлен в игру.
const PREORDER_YEAR: Record<string, number> = {
  Material_Preorder_Token: 2016,       // Specimen_AC_10 - первое поколение AC
  Preorder_Token_DE_10_gold: 2023,     // Specimen_DE_10 - вторая половина 2020-х
};

interface ChronoKey {
  year: number;
  season: number;
}

// Возвращает пару (год, сезон) для сортировки. Если год не найден нигде -
// null, такие жетоны падают в конец (после хронологии, до преордеров).
function chronoKey(id: string): ChronoKey | null {
  // 1. Preorder hardcoded
  if (PREORDER_YEAR[id] !== undefined) {
    return { year: PREORDER_YEAR[id], season: 6 };
  }
  // 2. Достаём год + текст события из sources.json
  const srcs = (sourcesMap as Record<string, { where?: string }[]>)[id];
  if (!srcs || srcs.length === 0) return null;
  for (const s of srcs) {
    const where = s.where ?? '';
    const m = where.match(/(19|20)\d{2}/);
    if (!m) continue;
    return { year: parseInt(m[0], 10), season: seasonOrder(where) };
  }
  return null;
}

// Разделяем материалы на 3 корзины: evergreen-жетоны (в начало), обычные
// жетоны (сортируются по chronoKey), всё остальное (в исходном порядке).
const evergreen: typeof materials = [];
const chronoTokens: typeof materials = [];
const undatedTokens: typeof materials = [];
const others: typeof materials = [];

for (const m of materials) {
  if (EVERGREEN_TOKENS.has(m.id)) {
    evergreen.push(m);
  } else if (isTokenId(m.id)) {
    const key = chronoKey(m.id);
    if (key) chronoTokens.push(m);
    else undatedTokens.push(m);
  } else {
    others.push(m);
  }
}

chronoTokens.sort((a, b) => {
  const ka = chronoKey(a.id)!;
  const kb = chronoKey(b.id)!;
  if (ka.year !== kb.year) return ka.year - kb.year;
  if (ka.season !== kb.season) return ka.season - kb.season;
  return a.id.localeCompare(b.id);
});

// Финальный порядок: [не-жетоны] -> [evergreen жетоны] -> [хроно-жетоны] ->
// [жетоны без известной даты]. Не-жетоны идут первыми, потому что каталог
// исторически начинается со зданий/материалов; жетоны - отдельный кластер
// в конце. Внутри кластера жетонов сначала базовые, потом хронология.
const rows = [...others, ...evergreen, ...chronoTokens, ...undatedTokens];
---

<BaseLayout
  title="Материалы"
  description="Материалы и ресурсы Mutants Genetic Gladiators (MGG): подробные характеристики и источники добычи."
  canonical="https://archivist-library.com/materials"
  viewport={NO_ZOOM_VIEWPORT}
>
  <section class="intro">
    <h1>Материалы</h1>
    <p>Красивый каталог материалов с текстурами, описаниями и местами добычи. Данные берутся из <code>src/data/materials/material.json</code>, пути к текстурам — из <code>public</code> по ID, а источники — из <code>src/data/materials/sources.json</code>.</p>
  </section>

  <MaterialsTable rows={rows} sourcesMap={sourcesMap} title="Каталог материалов" texturePrefix="/materials/" textureExt=".webp" />
</BaseLayout>

<style>
  .intro { margin-bottom: 1.25rem; }
  .intro h1 {
    margin: 0 0 0.4rem;
    font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.2rem);
    color: #f8fafc;
  }
  .intro p { margin: 0; color: #94a3b8; }
</style>
